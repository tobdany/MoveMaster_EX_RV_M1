<Configuration>
  <Target name="My Computer">
    <EnableDebuggingForAllVIs></EnableDebuggingForAllVIs>
    <VI name="main.vi">
      <Breakpoints>
        <NodeIndexes>
        </NodeIndexes>
        <SignalIndexes>
        </SignalIndexes>
      </Breakpoints>
      <Probes>
        <Generic>
          <SignalUID value="15590"/>
        </Generic>
      </Probes>
    </VI>
  </Target>
</Configuration>
