<Configuration>
  <Target name="My Computer">
    <EnableDebuggingForAllVIs>0</EnableDebuggingForAllVIs>
    <VI name="FGV_DatosMotores.vi">
      <Breakpoints>
        <NodeIndexes>
        </NodeIndexes>
        <SignalIndexes>
        </SignalIndexes>
      </Breakpoints>
      <Probes>
        <Generic>
          <SignalUID value="7280"/>
          <SignalUID value="5087"/>
        </Generic>
      </Probes>
    </VI>
    <VI name="WriteCommand.vi">
